<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tiêu đề yêu cầu -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Ib dis : mfxa_."
        android:textColor="#00E676"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="HariDwg AIM &amp; Fake Lag Engine"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:layout_marginBottom="16dp"/>

    <!-- Trạng thái Shizuku & Overlay -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:text="Trạng thái: Đang kiểm tra quyền hệ thống..."
        android:textColor="#FF5252"
        android:textSize="13sp" />

    <!-- Chọn phiên bản Game -->
    <RadioGroup
        android:id="@+id/radioGroupGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/rbFFNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="FF Thường"
            android:textColor="#FFFFFF" />
        <RadioButton
            android:id="@+id/rbFFMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="FF MAX"
            android:textColor="#FFFFFF" />
    </RadioGroup>

    <!-- Nút kích hoạt fix quyền và bật menu -->
    <Button
        android:id="@+id/btnActivate"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#00E676"
        android:text="CẤP QUYỀN &amp; KHỞI CHẠY MENU"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
