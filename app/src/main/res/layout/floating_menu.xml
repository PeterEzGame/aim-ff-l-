<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#99000000"
    android:orientation="vertical"
    android:padding="10dp"
    android:elevation="10dp">

    <!-- Tiêu đề menu có thể dùng làm điểm chạm để kéo -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="HariDwg AIM [PRO]"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <!-- Các công tắc tính năng -->
    <Switch
        android:id="@+id/switchAim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aim Assist Pro"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:thumbTint="#00E676"/>

    <Switch
        android:id="@+id/switchAntiCrash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bảo vệ Chống Văng"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:thumbTint="#00E676"
        android:checked="true"/>
        
    <Button
        android:id="@+id/btnCloseMenu"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:backgroundTint="#FF5252"
        android:text="Ẩn Menu"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:padding="0dp"/>
</LinearLayout>
